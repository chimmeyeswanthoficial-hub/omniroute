+/**
+ * `max` is a first-class alias of the built-in `auto` router: a request for
+ * model `max` (or `max/<variant>`, e.g. `max/coding`) routes through the
+ * auto engine — candidate pool of every provider with a configured key,
+ * per-request task scoring, auto fallback — exactly like `auto`.
+ *
+ * Normalized at the routing entry point (body model AND X-Route-Model header)
+ * so every downstream stage (auto-routing state, virtual combos, task-aware
+ * routing, fallback chains, usage logs via requested_model) sees `auto`.
+ * Note: a user-created combo literally named `max` is intentionally shadowed
+ * by this alias — the alias exists so `max` always means "route everything".
+ */
+export function normalizeMaxAlias(model: string | null | undefined): string | null | undefined {
+  if (typeof model !== "string") return model;
+  if (model === "max") return "auto";
+  if (model.startsWith("max/")) return `auto/${model.slice("max/".length)}`;
+  return model;
+}
